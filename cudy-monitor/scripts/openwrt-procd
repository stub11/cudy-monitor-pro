#!/bin/sh /etc/rc.common
# OpenWrt procd integration for a preinstalled Entware /opt binary.
# This is only installed on OpenWrt; it never alters DNS/firewall configuration.
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -x /opt/bin/cudy-monitor-pro ] || {
        echo "Cudy Monitor Pro: Entware /opt is not ready" >&2
        return 1
    }
    BIND=127.0.0.1:8237
    [ ! -s /opt/etc/cudy-monitor/bind ] || BIND=$(head -n 1 /opt/etc/cudy-monitor/bind)
    case "$BIND" in
      *[!0-9.:]*|*:*:*) echo "Invalid monitor bind address" >&2; return 1 ;;
    esac
    ACTIONS=0
    [ "$(head -n 1 /opt/etc/cudy-monitor/service-actions 2>/dev/null)" = 1 ] && ACTIONS=1
    procd_open_instance
    procd_set_param command /opt/bin/cudy-monitor-pro
    procd_set_param env "CUDY_MONITOR_BIND=$BIND" "CUDY_MONITOR_SERVICE_ACTIONS=$ACTIONS"
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
